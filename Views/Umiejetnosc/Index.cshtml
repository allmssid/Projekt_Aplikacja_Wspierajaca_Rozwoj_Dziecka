@model IEnumerable<Aplikacja_wspierajaca_rozwoj_dziecka.Models.Umiejetnosc>

@{
    ViewData["Title"] = "Umiejętności";
}

<div class="home-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="home-section-title mb-1">Umiejętności</h2>
            <p class="text-muted mb-0">
                Lista umiejętności rozwijanych przez dzieci – możesz je edytować lub dodać nowe.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Dodaj umiejętność
        </a>
    </div>

    <div class="home-card">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Obszar rozwoju</th>
                    <th>Zalecany wiek</th>
                    <th>Czy własna</th>
                    <th style="width: 160px;">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nazwa</td>
                        <td>@item.Kierunek</td>
                        <td>
                            @if (item.ZalecanyWiekOdRoku.HasValue || item.ZalecanyWiekDoRoku.HasValue)
                            {
                                @($"{item.ZalecanyWiekOdRoku ?? 0} - {item.ZalecanyWiekDoRoku ?? 0} lat")
                            }
                        </td>
                        <td>
                            @(item.CzyWlasna ? "Tak" : "Nie")
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                                Szczegóły
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                Edytuj
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                Usuń
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
