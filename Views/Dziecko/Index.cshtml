@model IEnumerable<Aplikacja_wspierajaca_rozwoj_dziecka.Models.Dziecko>

@{
    ViewData["Title"] = "Dzieci";
    var dzis = DateTime.Today;
}

<div class="home-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="home-section-title mb-1">Dzieci</h2>
            <p class="text-muted mb-0">
                Lista dzieci posiadających konto w systemie (rola <strong>Dziecko</strong>).
                Możesz podejrzeć szczegóły, edytować dane albo usunąć rekord.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Dodaj dziecko
        </a>
    </div>

    <div class="home-card">
        @if (!Model.Any())
        {
            <p class="mb-0 text-muted">
                Brak dzieci w bazie. Dodaj pierwsze dziecko przyciskiem
                <strong>„Dodaj dziecko”</strong>.
            </p>
        }
        else
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Dziecko</th>
                        <th>Wiek</th>
                        <th>Data urodzenia</th>
                        <th>Konto użytkownika</th>
                        <th style="width: 190px;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    var inicjaly = "";
                                    if (!string.IsNullOrWhiteSpace(item.Imie))
                                    {
                                        inicjaly += char.ToUpper(item.Imie[0]);
                                    }
                                    if (!string.IsNullOrWhiteSpace(item.Nazwisko))
                                    {
                                        inicjaly += char.ToUpper(item.Nazwisko[0]);
                                    }
                                    if (string.IsNullOrWhiteSpace(inicjaly))
                                    {
                                        inicjaly = "?";
                                    }
                                }
                                <div class="d-flex align-items-center">
                                    <div class="child-avatar me-2">
                                        @inicjaly
                                    </div>
                                    <div class="child-info">
                                        <div class="child-name">
                                            @item.Imie @item.Nazwisko
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notatki))
                                        {
                                            <div class="child-meta text-muted">
                                                @item.Notatki
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @{
                                    var wiek = dzis.Year - item.DataUrodzenia.Year;
                                    if (item.DataUrodzenia.Date > dzis.AddYears(-wiek))
                                    {
                                        wiek--;
                                    }
                                    var wiekOpis = (wiek == 1)
                                    ? "rok"
                                    : (wiek >= 2 && wiek <= 4 ? "lata" : "lat");
                                }
                                @wiek @wiekOpis
                            </td>
                            <td>
                                @item.DataUrodzenia.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                @* jeśli Dziecko ma nawigację User *@
                                @if (item.User != null)
                                {
                                    <span class="child-meta">
                                        @item.User.Email
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Brak powiązanego konta</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                                    Szczegóły
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    Edytuj
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    Usuń
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
