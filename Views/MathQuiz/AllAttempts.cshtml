@model IEnumerable<Aplikacja_wspierajaca_rozwoj_dziecka.Models.MathQuizAttempt>

@{
    ViewData["Title"] = "Wyniki quizów dzieci";
}

<div class="home-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="home-section-title mb-1">Wyniki quizów dzieci</h2>
            <p class="text-muted mb-0">
                Lista wszystkich prób quizu wykonanych przez dzieci.
            </p>
        </div>
    </div>

    <div class="home-card">
        @if (!Model.Any())
        {
            <p class="mb-0 text-muted">
                Brak zapisanych prób quizu.
            </p>
        }
        else
        {
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Dziecko / użytkownik</th>
                        <th>Przedmiot</th>
                        <th>Poziom</th>
                        <th>Wynik</th>
                        <th>Data podejścia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>
                                @if (attempt.Uzytkownik != null)
                                {
                                    <div class="child-info">
                                        @{
                                            var fullName = ((attempt.Uzytkownik.Imie ?? "") + " " + (attempt.Uzytkownik.Nazwisko ?? "")).Trim();
                                        }
                                        @if (!string.IsNullOrEmpty(fullName))
                                        {
                                            <div class="child-name">@fullName</div>
                                        }
                                        <div class="child-meta">
                                            @attempt.Uzytkownik.Email
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Brak danych użytkownika</span>
                                }
                            </td>
                            <td>@attempt.Przedmiot</td>
                            <td>@attempt.Poziom</td>
                            <td>
                                <strong>@attempt.PoprawneOdpowiedzi / @attempt.LiczbaPytan</strong>
                            </td>
                            <td>
                                @attempt.DataPodejscia.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
