@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset hasła";
}

<div class="auth-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="auth-card">
                <h1 class="auth-title">Zapomniałeś hasła? 🔐</h1>
                <p class="auth-subtitle">
                    Podaj adres e-mail powiązany z Twoim kontem. Wyślemy Ci link, dzięki któremu
                    ustawisz nowe hasło i wrócisz do quizów.
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control auth-input" autocomplete="email" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 auth-main-btn">
                        Wyślij link resetu hasła
                    </button>
                </form>

                <p class="auth-bottom-text">
                    Pamiętasz jednak hasło?
                    <a asp-page="./Login" class="auth-link">Zaloguj się</a>
                </p>
            </div>
        </div>

        <div class="col-lg-5 d-none d-lg-flex">
            <div class="auth-side-panel">
                <h2>Bezpieczny dostęp do nauki 🔒</h2>
                <ul>
                    <li>Twoje konto pozwala śledzić postępy w quizach.</li>
                    <li>Rodzice i nauczyciele widzą wyniki dziecka.</li>
                    <li>Hasło możesz w każdej chwili zresetować.</li>
                </ul>
                <div class="auth-side-badges">
                    <span>🔑 Bezpieczeństwo</span>
                    <span>📧 E-mail</span>
                    <span>📚 Nauka</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
